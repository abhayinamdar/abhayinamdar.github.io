<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} | {{ site.name }}{% else %}{{ site.title }}{% endif %}</title>
  <meta name="description" content="{{ summary or site.description }}">
  <meta property="og:title" content="{{ title or site.title }}">
  <meta property="og:description" content="{{ summary or site.description }}">
  <meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
  <meta name="color-scheme" content="light">
  <script>document.documentElement.classList.add("js")</script>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,300..800&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="{{ bodyClass }}">
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="frame header-inner">
      <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">AI</span><span>Abhay Inamdar</span></a>
      <nav aria-label="Main">
        <a href="/profile/" {% if page.url == "/profile/" %}aria-current="page"{% endif %}>Profile</a>
        <a href="/articles/" {% if "/articles/" in page.url %}aria-current="page"{% endif %}>Articles</a>
        <a href="{{ site.linkedin }}" rel="noopener">LinkedIn</a>
      </nav>
    </div>
  </header>
  <main id="main">
    {{ content | safe }}
  </main>
  <footer class="site-footer">
    <div class="frame">
      <div class="tblock">
        <div class="tb-cell tb-name"><span class="tb-label">Name</span>Abhay Inamdar</div>
        <div class="tb-cell"><span class="tb-label">Field</span>Pharmaceutical engineering and capital projects</div>
        <div class="tb-cell"><span class="tb-label">Contact</span><a href="{{ site.linkedin }}" rel="noopener">Message me on LinkedIn</a>{% if site.email %}<br><a href="mailto:{{ site.email }}">{{ site.email }}</a>{% endif %}</div>
        <div class="tb-cell"><span class="tb-label">Updated</span>{{ "" | year }}</div>
      </div>
    </div>
  </footer>
  <script>
    // Gentle fade-in as sections scroll into view.
    (function () {
      var items = document.querySelectorAll(".reveal");
      if (!("IntersectionObserver" in window) || window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        items.forEach(function (el) { el.classList.add("in"); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } });
      }, { rootMargin: "0px 0px -8% 0px" });
      items.forEach(function (el) { io.observe(el); });
    })();
  </script>
</body>
</html>
