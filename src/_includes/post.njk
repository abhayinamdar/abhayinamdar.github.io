---
layout: base.njk
bodyClass: post
---
<article class="frame article">
  <header class="article-head">
    <p class="back"><a href="/articles/">All articles</a></p>
    <h1>{{ title }}</h1>
    <p class="article-meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time><span>{{ content | readingTime }}</span></p>
  </header>
  <div class="prose reading">
    {{ content | safe }}
  </div>
  {% if linkedin %}
  <aside class="source-note">
    First published on <a href="{{ linkedin }}" rel="noopener">LinkedIn</a>.{% if has_images %} The original has diagrams and pictures that are not copied here.{% endif %}
  </aside>
  {% endif %}
</article>
