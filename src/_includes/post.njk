---
layout: base.njk
---
<article class="wrap narrow post">
  <p class="eyebrow"><a href="/articles/">← All articles</a></p>
  <h1>{{ title }}</h1>
  <p class="meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time> · {{ content | readingTime }}</p>
  <div class="prose">
    {{ content | safe }}
  </div>
  {% if linkedin %}
  <aside class="source-note">
    First published on <a href="{{ linkedin }}" rel="noopener">LinkedIn</a>.{% if has_images %} The original post also has diagrams and pictures.{% endif %}
  </aside>
  {% endif %}
</article>
