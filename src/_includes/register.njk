<ul class="projects">
  {% for p in profile.projects | limit(projectsLimit or 99) %}
  <li class="card project reveal">
    <span class="spine" aria-hidden="true"></span>
    <p class="p-top"><span class="p-years">{{ p.dates }}</span>{% if p.capex %}<span class="p-capex">{{ p.capex }}</span>{% endif %}</p>
    <h3>{{ p.name }}</h3>
    <p class="p-detail">{{ p.detail }}</p>
    <p class="p-where">{{ p.where }}{% if p.country %}<span>{{ p.country }}</span>{% endif %}</p>
  </li>
  {% endfor %}
</ul>
