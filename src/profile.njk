---
layout: base.njk
title: Profile
permalink: /profile/
bodyClass: profile
summary: Career, projects, expertise, education and awards of Abhay Inamdar, pharmaceutical engineering and capital projects leader.
---
<div class="frame split">
  <aside class="side">
    <div class="side-inner">
      <h1>Profile</h1>
      <p class="side-role">{{ profile.headline }}, {{ profile.current }}</p>
      <nav class="side-nav" aria-label="On this page">
        <a href="#about">About</a>
        <a href="#experience">Experience</a>
        <a href="#projects">Projects</a>
        <a href="#expertise">Expertise</a>
        <a href="#education">Education and awards</a>
      </nav>
    </div>
  </aside>

  <div class="main-col">
    <section id="about" class="block">
      <h2>About</h2>
      <div class="reading">
        {% for p in profile.about %}<p>{{ p }}</p>{% endfor %}
      </div>
      <p class="small">Languages: {{ profile.languages | join(", ") }}</p>
    </section>

    <section id="experience" class="block">
      <h2>Experience</h2>
      <ol class="jobs">
        {% for job in profile.experience %}
        <li class="job" id="{{ job.id }}">
          <div class="job-when">{{ job.years }}</div>
          <div class="job-body">
            <h3>{{ job.company }}</h3>
            {% if job.placeholder %}<p class="todo">{{ job.placeholder }}</p>{% endif %}
            {% for r in job.roles %}
            <div class="role">
              {% if r.title %}<p class="role-title">{{ r.title }}</p>{% endif %}
              {% if r.dates %}<p class="role-meta">{{ r.dates }}{% if r.place %}, {{ r.place }}{% endif %}</p>{% endif %}
              <ul>{% for pt in r.points %}<li>{{ pt }}</li>{% endfor %}</ul>
            </div>
            {% endfor %}
          </div>
        </li>
        {% endfor %}
        <li class="job">
          <div class="job-when">1990 – 2002</div>
          <div class="job-body"><h3>Early career</h3><p class="todo">{{ profile.earlyCareerPlaceholder }}</p></div>
        </li>
      </ol>
    </section>

    <section id="projects" class="block">
      <h2>Key projects</h2>
      {% include "register.njk" %}
    </section>

    <section id="expertise" class="block">
      <h2>Specialties and expertise</h2>
      <ul class="legend legend-full">
        {% for e in profile.expertise %}
        <li>
          {% set icon = e.icon %}{% include "icon.njk" %}
          <h3>{{ e.area }}</h3>
          <p>{{ e.text }}</p>
          <ul class="tags">{% for i in e.items %}<li>{{ i }}</li>{% endfor %}</ul>
        </li>
        {% endfor %}
      </ul>
    </section>

    <section id="education" class="block">
      <h2>Education</h2>
      <ul class="entries">
        {% for e in profile.education %}
        <li><span class="e-when">{{ e.dates }}</span><span class="e-what"><strong>{{ e.degree }}</strong>{{ e.school }}</span></li>
        {% endfor %}
      </ul>
      <h2 class="h2-follow">Certifications</h2>
      <ul class="entries">
        {% for c in profile.certifications %}
        <li><span class="e-when">{{ c.date }}</span><span class="e-what"><strong>{{ c.name }}</strong>{{ c.by }}</span></li>
        {% endfor %}
      </ul>
      <h2 class="h2-follow">Awards and recognition</h2>
      <ul class="entries">
        {% for a in profile.awards %}
        <li><span class="e-when">{{ a.date }}</span><span class="e-what"><strong>{{ a.name }}</strong>{{ a.by }}{% if a.note %}. {{ a.note }}{% endif %}</span></li>
        {% endfor %}
      </ul>
    </section>
  </div>
</div>
